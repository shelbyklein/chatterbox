#!/usr/bin/python3 -I
"""Send a task from this Chatterbox chat to the other agent (Claude <-> Codex) as a sidequest.

  sidequest "TASK"              from the chat you're working in (found by $CHATTERBOX_CHAT_ID,
                                or else the chat working right now in this folder)
  sidequest --chat ID "TASK"    from a particular chat

The sidequest opens beside the chat as a Sidechat on the other agent, caught up on the whole
conversation. When it finishes, its answer comes back to the chat as a new message and the
chat's agent carries on from it. Prints the sidequest's id.

As `pc-errand` (the same script, by another name), the task goes to Shelby-PC instead, on this
chat's own agent: for things only the PC can do, such as Photoshop there.
  pc-errand "TASK" [--file PATH ...] [--agent claude|codex]
Each --file is copied to the PC first and named in the task. When the errand finishes, the
files it made are copied back to this Mac and its answer arrives here, naming those copies.
"""
import argparse, json, os, socket, sys, uuid

DATA = os.environ.get("CHATTERBOX_DATA_DIR") or os.path.expanduser("~/Library/Application Support/Chatterbox")


def fail(message):
    print(f"sidequest: {message}", file=sys.stderr)
    sys.exit(1)


class Service:
    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(30)
        try:
            self.sock.connect(os.path.join(DATA, "daemon.sock"))
        except OSError:
            fail("Chatterbox's background service isn't running.")
        self.file = self.sock.makefile("rwb")
        self.request("hello", {"role": "agent"})

    def request(self, operation, body):
        rid = str(uuid.uuid4())
        self.file.write((json.dumps({"version": 1, "id": rid, "operation": operation, "body": body}) + "\n").encode())
        self.file.flush()
        while True:
            line = self.file.readline()
            if not line:
                fail("the background service closed the connection.")
            reply = json.loads(line)
            if reply.get("id") == rid:
                if reply.get("error"):
                    fail({"invalid_sidequest": "the background service didn't take it: say what the sidequest should do, or restart the service if it predates agent sidequests (scripts/restart-service.sh).",
                          "chat_not_found": "that chat isn't open in Chatterbox.",
                          "permission_denied": "a sidequest can only start from a chat that's working right now.",
                          "integration_disabled": "agent access to Chatterbox is turned off in its settings."}
                         .get(reply["error"], reply["error"]))
                return reply.get("result")


def folders(record):
    found = [record.get(k) for k in ("projectFolder", "worktreeOf", "sidechatFolder", "studioFolder")]
    found.append((record.get("codex") or {}).get("folder"))
    return {os.path.realpath(f) for f in found if f}


def claude_sessions():
    """Session ids of the Claude Code processes this command runs under (its ancestors)."""
    import subprocess
    found, pid = [], os.getppid()
    for _ in range(12):
        if pid <= 1:
            break
        out = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        if not out:
            break
        ppid, _, command = out.partition(" ")
        words = command.split()
        for flag in ("--resume", "--session-id"):
            if flag in words and words.index(flag) + 1 < len(words):
                found.append(words[words.index(flag) + 1])
        pid = int(ppid)
    return found


def current_chat(service):
    if os.environ.get("CHATTERBOX_CHAT_ID"):
        return os.environ["CHATTERBOX_CHAT_ID"]
    chats = [c["record"] for c in service.request("list", {}) or []]
    # A Claude chat started before CHATTERBOX_CHAT_ID: its process names its session.
    for session in claude_sessions():
        match = [r for r in chats if r.get("claudeSessionID") == session]
        if len(match) == 1:
            return match[0]["id"]
    here = os.path.realpath(os.getcwd())
    working = [c["record"] for c in service.request("list", {}) or [] if c.get("running")]
    matches = [r for r in working if here in folders(r) and not r.get("isDot")]
    if len(matches) == 1:
        return matches[0]["id"]
    if not matches:
        fail("couldn't tell which chat this is: none is working in this folder. Pass --chat ID.")
    fail("several chats are working in this folder: pass --chat ID (" + ", ".join(f"{r['id']} {r.get('title', '')!r}" for r in matches) + ").")


def main():
    errand = os.path.basename(sys.argv[0]) == "pc-errand"
    parser = argparse.ArgumentParser(description="Send a task to Shelby-PC as an errand." if errand
                                     else "Send a task to the other agent as a sidequest.")
    parser.add_argument("task", nargs="+")
    parser.add_argument("--chat")
    if errand:
        parser.add_argument("--file", action="append", default=[], help="a file on this Mac to send along")
        parser.add_argument("--agent", choices=["claude", "codex"], help="the agent on the PC (default: this chat's)")
    args = parser.parse_args()
    task = " ".join(args.task).strip()
    if not task:
        fail("say what the " + ("errand" if errand else "sidequest") + " should do.")
    service = Service()
    chat = args.chat or current_chat(service)
    if errand:
        files = [os.path.abspath(os.path.expanduser(f)) for f in args.file]
        for f in files:
            if not os.path.isfile(f):
                fail(f"no such file: {f}")
        service.sock.settimeout(600)   # Copying files to the PC can take a while.
        body = {"chatID": chat, "task": task, "files": files}
        if args.agent:
            body["agent"] = args.agent
        quest = service.request("pcErrand", body)
        print(f"Sent errand {quest} to Shelby-PC. Its answer (and any files, copied here) comes back to this chat when it's done.")
        return
    quest = service.request("sidequest", {"chatID": chat, "task": task})
    print(f"Started sidequest {quest}. Its answer comes back to this chat as a new message when it's done.")


main()
