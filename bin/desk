#!/usr/bin/python3 -I
"""Put work on Chatterbox's Desk for Shelby to place and start (plans/front-desk.md).

  desk add "TEXT" [--place NAME] [--note NOTE]
                    a request on the Desk; --place names a Studio or project to propose
                    (otherwise the Desk proposes one, or none); --note is a line about it
                    (where it came from, a link, a deadline). Prints where it was proposed.
                    [--source clickup:<id or link> | email:<message id>] [--source-title T]
                    [--source-url URL] preserves the verified original web link
                    where it came from, so its card warns when ClickUp or the email
                    disagrees with the board (a ClickUp link in --note counts too)
                    [--confidence yes|no --reason "..."]
                    can an agent finish it without Shelby? No if it needs Shelby's creative
                    judgment, info or access that isn't there, an outward-facing step
                    (email, publishing, ClickUp), approvals mid-work, or has no clear
                    place; else yes. Yes tasks with a place start by themselves.
  desk source REF --status STATUS [--from NAME] [--title T] [--url URL] [--task DESK_ID]
                    what a task's source says now: ClickUp's status ("in progress",
                    "complete"), or an email's "new reply" (--from who wrote it),
                    "waiting on them" or "answered"
  desk list         what's on the Desk now: requests waiting to be placed, one per line
  desk places       the Studios and projects work can go in

Agents add requests; only Shelby starts them, so nothing runs until it's placed. Check
`desk list` first so the same request isn't added twice.
"""
import argparse, json, os, socket, sys, uuid

DATA = os.environ.get("CHATTERBOX_DATA_DIR") or os.path.expanduser("~/Library/Application Support/Chatterbox")


def fail(message):
    print(f"desk: {message}", file=sys.stderr)
    sys.exit(1)


class Service:
    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(30)
        try:
            self.sock.connect(os.path.join(DATA, "daemon.sock"))
        except OSError:
            fail("Chatterbox's background service isn't running.")
        self.file = self.sock.makefile("rwb")
        self.request("hello", {"role": "agent"})

    def request(self, operation, body):
        rid = str(uuid.uuid4())
        self.file.write((json.dumps({"version": 1, "id": rid, "operation": operation, "body": body}) + "\n").encode())
        self.file.flush()
        while True:
            line = self.file.readline()
            if not line:
                fail("the background service closed the connection.")
            reply = json.loads(line)
            if reply.get("id") == rid:
                if reply.get("error"):
                    fail({"unsupported_operation": "this Chatterbox has no Desk yet; restart its service (scripts/restart-service.sh).",
                          "permission_denied": "agents can only add to the Desk and read it."}
                         .get(reply["error"], reply["error"]))
                return reply.get("result")


def main():
    parser = argparse.ArgumentParser(prog="desk", description="Put work on Chatterbox's Desk.")
    commands = parser.add_subparsers(dest="command", required=True)
    add = commands.add_parser("add", help="put a request on the Desk")
    add.add_argument("text")
    add.add_argument("--place", help="a Studio's or project's name to propose")
    add.add_argument("--note", help="a line about it: where it came from, a link, a deadline")
    add.add_argument("--source", dest="origin", help="clickup:<task id or link>, or email:<message id>")
    add.add_argument("--source-title", dest="origin_title", help="the ClickUp task's name or the email's subject")
    add.add_argument("--source-url", dest="origin_url", help="verified web link to the original email or task")
    add.add_argument("--confidence", choices=["yes", "no"], help="can an agent finish it without Shelby?")
    add.add_argument("--reason", help="why: what makes it safe, or what needs Shelby")
    src = commands.add_parser("source", help="report what a task's source (ClickUp, an email) says now")
    src.add_argument("ref", help="clickup:<task id or link>, or email:<message id>")
    src.add_argument("--status", required=True)
    src.add_argument("--from", dest="reply_from", help="an email's new reply: who wrote it")
    src.add_argument("--title", help="the ClickUp task's name or the email's subject")
    src.add_argument("--url", help="verified web link to the original email or task")
    src.add_argument("--task", help="update only this Desk task ID; also attaches a missing source")
    listing = commands.add_parser("list", help="requests waiting on the Desk")
    listing.add_argument("--json", action="store_true", help="full board including working, review and done source references, for de-duplication")
    commands.add_parser("places", help="Studios and projects")
    args = parser.parse_args()
    service = Service()

    if args.command == "add":
        text = args.text.strip()
        if not text:
            fail("say what needs doing.")
        body = {"action": "add", "text": text}
        if args.place:
            body["place"] = args.place
        if args.note:
            body["note"] = args.note
        if args.origin:
            body["origin"] = args.origin
        if args.origin_title:
            body["originTitle"] = args.origin_title
        if args.origin_url:
            body["originURL"] = args.origin_url
        if args.confidence:
            if not args.reason:
                fail("give --reason with --confidence.")
            body["confidence"] = args.confidence
            body["reason"] = args.reason
        desk = service.request("desk", body) or {}
        mine = next((r for r in desk.get("incoming", []) if r.get("text") == text), None)
        place = (mine or {}).get("proposed")
        print(f"On the Desk{', proposed for ' + place['name'] if place else ', with no place proposed (Shelby will choose)'}.")
    elif args.command == "source":
        body = {"action": "origin", "ref": args.ref, "status": args.status}
        if args.reply_from:
            body["replyFrom"] = args.reply_from
        if args.title:
            body["title"] = args.title
        if args.url:
            body["url"] = args.url
        if args.task:
            body["task"] = args.task
        service.request("desk", body)
        print(f"Noted: {args.ref} says {args.status}.")
    elif args.command == "list":
        desk = service.request("desk", {"action": "get"}) or {}
        if args.json:
            print(json.dumps(desk, ensure_ascii=False))
            return
        incoming = desk.get("incoming", [])
        if not incoming:
            print("Nothing waiting to be placed.")
        for r in incoming:
            place = (r.get("proposed") or {}).get("name") or "no place"
            note = f" — {r['note']}" if r.get("note") else ""
            origin = r.get("origin")
            if origin:
                note += f" (source {origin.get('kind')}:{origin.get('id')}" + (f", {origin['status']}" if origin.get("status") else "") + ")"
            print(f"- {r.get('text')} [{place}; from {r.get('source')}]{note}")
    else:
        for p in service.request("desk", {"action": "places"}) or []:
            detail = f" — {p['detail']}" if p.get("detail") else ""
            print(f"- {p.get('kind')}: {p.get('name')}{detail}")


if __name__ == "__main__":
    main()
