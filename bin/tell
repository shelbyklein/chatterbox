#!/usr/bin/python3 -I
"""Hand information between Chatterbox sessions.

  tell "SESSION" "MESSAGE"   send MESSAGE to another session; its agent hears it as a
                             <session_message> and picks it up (queued if it's mid-reply)
  tell --list [WORDS]        sessions to send to, newest first (titles with WORDS)
  tell --read "SESSION" [--last N]
                             that session's latest messages (default 6), to pull in what it knows

SESSION is a title (exact, or words unique to one), or an id or the start of one. The message
comes from this session (found by $CHATTERBOX_CHAT_ID, or the session this runs under; --chat ID
to say). A turn may send a few messages; a reply to a message can't be answered with another,
so two sessions never loop.
"""
import argparse, datetime, json, os, socket, sys, uuid

DATA = os.environ.get("CHATTERBOX_DATA_DIR") or os.path.expanduser("~/Library/Application Support/Chatterbox")


def fail(message):
    print(f"tell: {message}", file=sys.stderr)
    sys.exit(1)


class Service:
    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(30)
        try:
            self.sock.connect(os.path.join(DATA, "daemon.sock"))
        except OSError:
            fail("Chatterbox's background service isn't running.")
        self.file = self.sock.makefile("rwb")
        self.request("hello", {"role": "agent"})

    def request(self, operation, body):
        rid = str(uuid.uuid4())
        self.file.write((json.dumps({"version": 1, "id": rid, "operation": operation, "body": body}) + "\n").encode())
        self.file.flush()
        while True:
            line = self.file.readline()
            if not line:
                fail("the background service closed the connection.")
            reply = json.loads(line)
            if reply.get("id") == rid:
                if reply.get("error"):
                    fail({"unsupported_operation": "this Chatterbox can't pass messages between sessions yet; its background service needs a restart on the newer version.",
                          "permission_denied": "a message goes from this session while it's replying; run tell from your own turn.",
                          "chat_not_found": "that session is gone."}.get(reply["error"], reply["error"]))
                return reply.get("result")


def claude_sessions():
    """Session ids of the Claude Code processes this command runs under (its ancestors)."""
    import subprocess
    found, pid = [], os.getppid()
    for _ in range(12):
        if pid <= 1:
            break
        out = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        if not out:
            break
        ppid, _, command = out.partition(" ")
        words = command.split()
        for flag in ("--resume", "--session-id"):
            if flag in words and words.index(flag) + 1 < len(words):
                found.append(words[words.index(flag) + 1])
        pid = int(ppid)
    return found


def current_chat(chats, given):
    if given:
        return given
    if os.environ.get("CHATTERBOX_CHAT_ID"):
        return os.environ["CHATTERBOX_CHAT_ID"]
    for session in claude_sessions():
        match = [r for r in chats if r.get("claudeSessionID") == session]
        if len(match) == 1:
            return match[0]["id"]
    fail("couldn't tell which session this is. Pass --chat ID.")


def sessions(service):
    listed = service.request("list", {"summaryOnly": True}) or []
    for c in listed:
        c["record"]["_running"] = c.get("running", False)
        c["record"]["_summary"] = c.get("summary") or {}
    return [c["record"] for c in listed]


def find(chats, wanted, me=None):
    """The one session `wanted` names: an id or its start, an exact title, or words in one title."""
    live = [r for r in chats if not r.get("archivedAt") and r["id"] != me]
    w = wanted.strip().lower()
    by_id = [r for r in chats if r["id"].lower() == w or (len(w) >= 6 and r["id"].lower().startswith(w))]
    if len(by_id) == 1:
        return by_id[0]
    exact = [r for r in live if (r.get("title") or "").lower() == w]
    if len(exact) == 1:
        return exact[0]
    words = w.split()
    partial = exact or [r for r in live if all(word in (r.get("title") or "").lower() for word in words)]
    if len(partial) == 1:
        return partial[0]
    if not partial:
        fail(f"no session is called “{wanted}”. `tell --list` shows them.")
    names = "\n".join(f"  {r['id'][:8]}  {r.get('title') or 'Untitled'}" for r in newest(partial)[:8])
    fail(f"“{wanted}” could be several sessions; name one by its id:\n{names}")


def newest(records):
    return sorted(records, key=lambda r: r.get("updatedAt") or "", reverse=True)


def ago(stamp):
    if not stamp:
        return ""
    try:
        when = datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        return ""
    minutes = int((datetime.datetime.now(datetime.timezone.utc) - when).total_seconds() // 60)
    if minutes < 60:
        return f"{max(minutes, 1)} min ago"
    if minutes < 48 * 60:
        return f"{minutes // 60} hr ago"
    return f"{minutes // (24 * 60)} days ago"


def main():
    parser = argparse.ArgumentParser(prog="tell", description="Hand information between Chatterbox sessions.")
    parser.add_argument("--chat", help="the session sending (else this session)")
    parser.add_argument("--list", nargs="*", metavar="WORDS", help="sessions to send to, newest first")
    parser.add_argument("--read", metavar="SESSION", help="a session's latest messages")
    parser.add_argument("--last", type=int, default=6, help="with --read: how many messages (default 6)")
    parser.add_argument("session", nargs="?", help="the session to send to")
    parser.add_argument("message", nargs="?", help="what to send")
    args = parser.parse_args()
    service = Service()
    chats = sessions(service)

    if args.list is not None:
        words = [w.lower() for w in args.list]
        found = [r for r in newest(chats) if not r.get("archivedAt") and all(w in (r.get("title") or "").lower() for w in words)]
        if not found:
            print("No sessions match." if words else "No sessions.")
        for r in found[:25]:
            folder = r.get("projectFolder") or r.get("worktreeOf")
            place = f" · {os.path.basename(folder.rstrip('/'))}" if folder else ""
            state = " · working" if r.get("_running") else ""
            print(f"{r['id'][:8]}  {r.get('title') or 'Untitled'}{place}{state} · {ago(r.get('updatedAt'))}")
        return

    if args.read:
        target = find(chats, args.read)
        state = service.request("get", {"chatID": target["id"], "limit": 80}) or {}
        rows = [i for i in (state.get("record") or {}).get("items", []) if i.get("kind") in ("user", "assistant") and (i.get("text") or "").strip()]
        print(f"“{target.get('title') or 'Untitled'}” ({target['id'][:8]}), latest {min(args.last, len(rows))} of its messages:")
        for row in rows[-max(1, args.last):]:
            who = "User" if row["kind"] == "user" else "Agent"
            text = row["text"].strip()
            if len(text) > 1500:
                text = text[:1500] + " …"
            print(f"\n[{who}] {text}")
        return

    if not args.session or not args.message:
        parser.error('send with: tell "SESSION" "MESSAGE"')
    me = current_chat(chats, args.chat)
    target = find(chats, args.session, me=me)
    title = service.request("tell", {"chatID": me, "to": target["id"], "text": args.message})
    print(f"Sent to “{title}”. Its agent picks it up{' after its current reply' if target.get('_running') else ' now'}.")


if __name__ == "__main__":
    main()
