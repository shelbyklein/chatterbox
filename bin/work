#!/usr/bin/python3 -I
"""Work threads: fresh Chatterbox threads that do one piece of work for this session (the front
thread) and report back to it (plans/work-threads.md).

  work start "TITLE" --brief TEXT [--agent claude|codex] [--model M]
                    a work thread in this session's folder, started with the brief as its first
                    message (it gets the brief, not this conversation), on this session's agent
                    and model unless you choose; its task goes on the Desk. Prints its id.
                    --brief - reads the brief from stdin.
  work list         this session's work threads and their state (Working, Needs you, Ready, Done)
  work report "TEXT"
                    from a work thread: send TEXT to its front thread now, as its result (the
                    reply that ends this turn isn't sent again)

A start waits up to 90 s for a busy service (CHATTERBOX_WORK_START_TIMEOUT); if it gets no answer,
it looks for the thread in `work list` before saying it failed.

The session is found by $CHATTERBOX_CHAT_ID, or else the one working right now in this folder;
--chat ID names it. Start them only from a session that's working right now (your own); a work
thread can't start work threads of its own. When a work thread is done (a reply that ends with no
background command or subagent still running), the reply goes to the front thread as a new
message by itself; a reply that ends while background work runs is progress, shown in
`work list`, and the work thread reports after it picks back up and finishes.
"""
import argparse, json, os, socket, sys, time, uuid

DATA = os.environ.get("CHATTERBOX_DATA_DIR") or os.path.expanduser("~/Library/Application Support/Chatterbox")
STATES = {"working": "Working", "needsYou": "Needs you", "ready": "Ready", "done": "Done"}
# Starting one saves a thread and sends its brief: a busy service can take a while to answer.
START_TIMEOUT = float(os.environ.get("CHATTERBOX_WORK_START_TIMEOUT", "90"))


def fail(message):
    print(f"work: {message}", file=sys.stderr)
    sys.exit(1)


class Service:
    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(30)
        try:
            self.sock.connect(os.path.join(DATA, "daemon.sock"))
        except OSError:
            fail("Chatterbox's background service isn't running.")
        self.file = self.sock.makefile("rwb")
        self.request("hello", {"role": "agent"})

    def request(self, operation, body, timeout=30):
        rid = str(uuid.uuid4())
        self.sock.settimeout(timeout)
        self.file.write((json.dumps({"version": 1, "id": rid, "operation": operation, "body": body}) + "\n").encode())
        self.file.flush()
        while True:
            try:
                line = self.file.readline()
            except (socket.timeout, TimeoutError):
                raise Busy()
            if not line:
                fail("the background service closed the connection.")
            reply = json.loads(line)
            if reply.get("id") == rid:
                if reply.get("error"):
                    fail({"unsupported_operation": "this Chatterbox has no work threads yet; its background service needs a restart on the newer version.",
                          "chat_not_found": "that session isn't open in Chatterbox.",
                          "nested_work": "this is a work thread, and a work thread can't start work threads of its own. Do the work here, or report back with `work report`.",
                          "not_work_thread": "this session isn't a work thread, so it has nothing to report to.",
                          "invalid_report": "say what to report.",
                          "permission_denied": "work threads start (and report) only from a session that's working right now."}
                         .get(reply["error"], reply["error"]))
                return reply.get("result")


class Busy(Exception):
    """The service didn't answer in time; the request may still have gone through."""


def started_meanwhile(chat, title, before):
    """After `work start` timed out: the thread it made anyway, if the service did make one."""
    deadline = time.time() + 30
    while True:
        try:
            threads = Service().request("work", {"action": "list", "chatID": chat}) or []
        except Busy:
            threads = []
        found = [t for t in threads if t.get("id") not in before and t.get("title") == title]
        if found or time.time() > deadline:
            return found[0] if found else None
        time.sleep(3)


def folders(record):
    found = [record.get(k) for k in ("projectFolder", "worktreeOf", "sidechatFolder", "studioFolder")]
    found.append((record.get("codex") or {}).get("folder"))
    return {os.path.realpath(f) for f in found if f}


def claude_sessions():
    """Session ids of the Claude Code processes this command runs under (its ancestors)."""
    import subprocess
    found, pid = [], os.getppid()
    for _ in range(12):
        if pid <= 1:
            break
        out = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        if not out:
            break
        ppid, _, command = out.partition(" ")
        words = command.split()
        for flag in ("--resume", "--session-id"):
            if flag in words and words.index(flag) + 1 < len(words):
                found.append(words[words.index(flag) + 1])
        pid = int(ppid)
    return found


def current_chat(service):
    if os.environ.get("CHATTERBOX_CHAT_ID"):
        return os.environ["CHATTERBOX_CHAT_ID"]
    chats = [c["record"] for c in service.request("list", {"summaryOnly": True}) or []]
    for session in claude_sessions():
        match = [r for r in chats if r.get("claudeSessionID") == session]
        if len(match) == 1:
            return match[0]["id"]
    here = os.path.realpath(os.getcwd())
    working = [c["record"] for c in service.request("list", {"workingOnly": True, "summaryOnly": True}) or [] if c.get("running")]
    matches = [r for r in working if here in folders(r)]
    if len(matches) == 1:
        return matches[0]["id"]
    if not matches:
        fail("couldn't tell which session this is: none is working in this folder. Pass --chat ID.")
    fail("several sessions are working in this folder: pass --chat ID (" + ", ".join(f"{r['id']} {r.get('title', '')!r}" for r in matches) + ").")


def main():
    # --chat works before or after the command.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--chat", default=argparse.SUPPRESS, help="the session (default: this one)")
    parser = argparse.ArgumentParser(prog="work", parents=[common], description="Start work threads, list them, or report back from one.")
    commands = parser.add_subparsers(dest="command", required=True)
    start = commands.add_parser("start", parents=[common], help="start a work thread from this session")
    start.add_argument("title")
    start.add_argument("--brief", required=True, help="what to do, what's decided, which files to read (- reads stdin)")
    start.add_argument("--agent", choices=["claude", "codex"])
    start.add_argument("--model")
    commands.add_parser("list", parents=[common], help="this session's work threads")
    report = commands.add_parser("report", parents=[common], help="from a work thread: send a result to its front thread")
    report.add_argument("text", nargs="+")
    args = parser.parse_args()
    try:
        service = Service()
        chat = getattr(args, "chat", None) or current_chat(service)
    except Busy:
        fail("the background service is busy and didn't answer in time. Try again in a minute.")

    if args.command == "start":
        title = args.title.strip()
        brief = (sys.stdin.read() if args.brief == "-" else args.brief).strip()
        if not title:
            fail("name the work thread.")
        if not brief:
            fail("give it a brief: what to do, what's decided, which files to read.")
        body = {"action": "start", "chatID": chat, "title": title, "brief": brief}
        if args.agent:
            body["agent"] = args.agent
        if args.model:
            body["model"] = args.model
        try:
            before = {t.get("id") for t in service.request("work", {"action": "list", "chatID": chat}) or []}
        except Busy:
            fail("the background service is busy and didn't answer in time. Try again in a minute.")
        try:
            summary = (service.request("work", body, timeout=START_TIMEOUT) or {}).get("summary") or {}
        except Busy:
            # It may have started all the same: never report a failure for a thread that exists.
            made = started_meanwhile(chat, title, before)
            if not made:
                fail(f"the background service didn't answer in {START_TIMEOUT:g} s, and no work thread “{title}” has appeared. Check `work list` before starting it again.")
            summary = {"id": made.get("id"), "title": made.get("title")}
        print(f"Started work thread {summary.get('id')} “{summary.get('title', title)}”. Its result comes back to this session as a new message when it finishes.")
    elif args.command == "list":
        try:
            threads = service.request("work", {"action": "list", "chatID": chat}) or []
        except Busy:
            fail("the background service is busy and didn't answer in time. Try again in a minute.")
        if not threads:
            print("No work threads.")
        for t in threads:
            status = f": {t['status']}" if t.get("state") == "working" and t.get("status") else ""
            print(f"- {t.get('title')} [{STATES.get(t.get('state'), t.get('state'))}{status}; {t.get('backend')}] {t.get('id')}")
    else:
        text = " ".join(args.text).strip()
        if not text:
            fail("say what to report.")
        try:
            service.request("work", {"action": "report", "chatID": chat, "text": text})
        except Busy:
            fail("the background service is busy and didn't answer in time; the report may not have gone. Try again in a minute.")
        print("Reported to the front session.")


if __name__ == "__main__":
    main()
