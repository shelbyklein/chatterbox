#!/usr/bin/python3
"""Publish small web artifacts to https://snippets.shelbyklein.com (hosted on the Beelink).

  snippet publish FILE [--private] [--to PATH]   publish an HTML page (with the files it uses),
                                                 or any single file or folder
  snippet url FILE [--private]                   where FILE would be published, without publishing
  snippet list                                   what's published
  snippet remove PATH                            unpublish (PATH as shown by list)

Addresses mirror where the file lives:
  ~/Chatterbox/Studios/<Studio>/a/b.html  ->  /studio/<studio>/a/b.html
  <git repo>/a/b.html                     ->  /project/<repo>/a/b.html
  anywhere else /…/<folder>/b.html        ->  /chat/<folder>/b.html
--private puts it under /private/…, which only Shelby can open once Cloudflare Access is set up.

An HTML page is published with the local files it references (images, CSS, scripts, fonts),
and nothing else from its folder. Publishing reaches the Beelink over the home network.
"""
import argparse, html.parser, os, re, shlex, subprocess, sys, tempfile, urllib.parse

HOST = "beelink"
SITE = "/srv/projects/snippets/site"
BASE = "https://snippets.shelbyklein.com"
STUDIOS = os.path.expanduser("~/Chatterbox/Studios")
LIMIT = 200 * 1024 * 1024
SKIP_DIRS = {".git", "node_modules", ".DS_Store", "__pycache__", ".build", "build", "DerivedData"}


def fail(message):
    print(f"snippet: {message}", file=sys.stderr)
    sys.exit(1)


def slug(name):
    s = re.sub(r"[^a-z0-9._-]+", "-", name.lower()).strip("-.")
    return s or "untitled"


def root_of(path):
    """The folder an address mirrors from, and its address prefix."""
    real = os.path.realpath(path)
    studios = os.path.realpath(STUDIOS)
    if real.startswith(studios + os.sep):
        name = os.path.relpath(real, studios).split(os.sep)[0]
        return os.path.join(studios, name), f"studio/{slug(name)}"
    folder = real if os.path.isdir(real) else os.path.dirname(real)
    try:
        top = subprocess.run(["git", "-C", folder, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=True).stdout.strip()
        if top:
            return os.path.realpath(top), f"project/{slug(os.path.basename(top))}"
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass
    return folder, f"chat/{slug(os.path.basename(folder))}"


class Refs(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.refs = []

    def handle_starttag(self, tag, attrs):
        for key, value in attrs:
            if not value:
                continue
            if key in ("src", "href", "poster", "data", "xlink:href"):
                self.refs.append(value)
            elif key in ("srcset", "imagesrcset"):
                self.refs += [part.strip().split(" ")[0] for part in value.split(",") if part.strip()]
            elif key == "style":
                self.refs += css_refs(value)

    def handle_data(self, data):
        self.refs += css_refs(data) if "url(" in data else []


def css_refs(text):
    found = re.findall(r"url\(\s*['\"]?([^'\")]+)['\"]?\s*\)", text)
    return found + re.findall(r"@import\s+['\"]([^'\"]+)['\"]", text)


def local(ref, base_dir):
    """The local file a reference points to, or None for remote/inline/anchor references."""
    ref = ref.strip()
    if not ref or ref.startswith(("#", "data:", "mailto:", "tel:", "javascript:", "//", "blob:")) or re.match(r"^[a-z][a-z0-9+.-]*:", ref, re.I):
        return None
    path = urllib.parse.unquote(ref.split("#")[0].split("?")[0])
    if not path:
        return None
    path = os.path.normpath(os.path.join(base_dir, path.lstrip("/")) if not path.startswith("/") else path)
    return path if os.path.isfile(path) else None


def page_files(page, root):
    """The page plus the local files it (and its stylesheets) reference, inside root."""
    files, queue, outside = {os.path.realpath(page)}, [os.path.realpath(page)], []
    while queue:
        current = queue.pop()
        if not current.endswith((".html", ".htm", ".css", ".svg")):
            continue
        try:
            text = open(current, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        if current.endswith(".css"):
            refs = css_refs(text)
        else:
            parser = Refs()
            parser.feed(text)
            refs = parser.refs
        for ref in refs:
            found = local(ref, os.path.dirname(current))
            if not found:
                continue
            found = os.path.realpath(found)
            if not found.startswith(root + os.sep):
                outside.append(ref)
                continue
            if found not in files:
                files.add(found)
                queue.append(found)
    return sorted(files), outside


def folder_files(folder):
    files = []
    for dirpath, dirnames, filenames in os.walk(folder):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
        files += [os.path.join(dirpath, f) for f in filenames if not f.startswith(".")]
    return files


def plan(path, private, to):
    if not os.path.exists(path):
        fail(f"no such file: {path}")
    real = os.path.realpath(path)
    root, prefix = root_of(real)
    if to:
        to = to.strip("/")
        if ".." in to.split("/"):
            fail("--to can't contain ..")
        prefix = to
        root = real if os.path.isdir(real) else os.path.dirname(real)
    if private:
        prefix = f"private/{prefix}"
    if os.path.isdir(real):
        files, outside = folder_files(real), []
    elif real.endswith((".html", ".htm")):
        files, outside = page_files(real, root)
    else:
        files, outside = [real], []
    return root, prefix, files, outside


def url(prefix, rel):
    return f"{BASE}/{urllib.parse.quote(prefix + '/' + rel)}"


def ssh(command, **kwargs):
    return subprocess.run(["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", HOST, command], **kwargs)


def publish(args):
    root, prefix, files, outside = plan(args.file, args.private, args.to)
    total = sum(os.path.getsize(f) for f in files)
    if total > LIMIT:
        fail(f"{len(files)} files, {total // 1048576} MB: over the {LIMIT // 1048576} MB limit for a snippet")
    rels = [os.path.relpath(f, root) for f in files]
    with tempfile.NamedTemporaryFile("w", delete=False, prefix="snippet-files.") as listing:
        listing.write("\n".join(rels) + "\n")
    dest = f"{SITE}/{prefix}/"
    try:
        made = ssh(f"mkdir -p {shlex.quote(dest)}", capture_output=True, text=True)
        if made.returncode:
            fail(f"couldn't reach the Beelink ({made.stderr.strip() or 'no answer'}). Publishing works on the home network.")
        sent = subprocess.run(["rsync", "-a", "--files-from", listing.name, root + "/", f"{HOST}:{dest}"],
                              capture_output=True, text=True)
        if sent.returncode:
            fail(f"upload failed: {sent.stderr.strip()}")
        # The web server reads as another user; macOS's rsync can't set modes while copying.
        ssh(f"chmod -R a+rX {shlex.quote(dest)}", capture_output=True)
    finally:
        os.unlink(listing.name)
    main = os.path.relpath(os.path.realpath(args.file), root)
    if os.path.isdir(os.path.realpath(args.file)):
        main = main + "/" + ("index.html" if os.path.exists(os.path.join(args.file, "index.html")) else "")
    print(url(prefix, main.lstrip("./") if main != "." else ""))
    print(f"  {len(files)} file{'s' if len(files) != 1 else ''}, {max(1, total // 1024)} KB" + (" · private" if args.private else " · public: anyone with the link can open it"))
    if outside:
        print(f"  not included (outside {os.path.basename(root)}): {', '.join(sorted(set(outside))[:5])}")
    if args.private:
        print("  note: private snippets open only once Cloudflare Access protects /private")


def show_url(args):
    root, prefix, files, _ = plan(args.file, args.private, args.to)
    print(url(prefix, os.path.relpath(os.path.realpath(args.file), root)))


def list_published(_):
    out = ssh(f"cd {shlex.quote(SITE)} && find . -type f \\( -name '*.html' -o -name '*.htm' \\) | sort", capture_output=True, text=True)
    if out.returncode:
        fail("couldn't reach the Beelink. Publishing works on the home network.")
    pages = [line[2:] for line in out.stdout.splitlines() if line.startswith("./")]
    print("\n".join(f"{p}  {BASE}/{urllib.parse.quote(p)}" for p in pages) or "Nothing published yet.")


def remove(args):
    path = args.path.strip("/")
    if path.startswith(BASE):
        path = urllib.parse.unquote(path[len(BASE):]).strip("/")
    parts = path.split("/")
    named = parts[1:] if parts[:1] == ["private"] else parts
    # At least a Studio's, project's or chat's own folder: never a whole category.
    if ".." in parts or len(named) < 2 or named[0] not in ("studio", "project", "chat"):
        fail("give a published path, as shown by snippet list (at least studio/<name>)")
    out = ssh(f"cd {shlex.quote(SITE)} && test -e {shlex.quote(path)} && rm -rf -- {shlex.quote(path)}", capture_output=True, text=True)
    print(f"Removed {path}" if out.returncode == 0 else f"Nothing published at {path}")


def main():
    parser = argparse.ArgumentParser(prog="snippet", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("publish", "url"):
        p = sub.add_parser(name)
        p.add_argument("file")
        p.add_argument("--private", action="store_true")
        p.add_argument("--to", help="publish under this path instead of the mirrored one")
    sub.add_parser("list")
    r = sub.add_parser("remove")
    r.add_argument("path")
    args = parser.parse_args()
    {"publish": publish, "url": show_url, "list": list_published, "remove": remove}[args.command](args)


if __name__ == "__main__":
    main()
